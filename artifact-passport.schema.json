{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artifact-passport:schema:0.7",
  "title": "Artifact Passport 0.7",
  "description": "A portable, non-executable implementation contract for a digital artifact, paired with current-state handoff and optional measured handoff-evaluation receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "passport_id",
    "artifact",
    "intent",
    "operation",
    "structure",
    "constraints",
    "procedures",
    "verification",
    "authority",
    "handoff",
    "review"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference"
    },
    "spec_version": {
      "const": "0.7"
    },
    "passport_id": {
      "type": "string",
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "intent": {
      "$ref": "#/$defs/intent"
    },
    "operation": {
      "$ref": "#/$defs/operation"
    },
    "structure": {
      "$ref": "#/$defs/structure"
    },
    "constraints": {
      "$ref": "#/$defs/constraints"
    },
    "procedures": {
      "$ref": "#/$defs/procedures"
    },
    "verification": {
      "$ref": "#/$defs/verification"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "authority": {
      "$ref": "#/$defs/authority"
    },
    "handoff": {
      "$ref": "#/$defs/handoff"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "artifact_fingerprint": {
      "$ref": "#/$defs/artifactFingerprint"
    },
    "intake": {
      "$ref": "#/$defs/intake"
    },
    "unresolved": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedItem"
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$"
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "pathItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "intakeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "media_type",
        "role"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "media_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "intakeObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "status",
        "value"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "status": {
          "enum": [
            "extracted",
            "inferred",
            "owner-required"
          ]
        },
        "value": true,
        "source": {
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "accepted": {
          "type": "boolean"
        },
        "reviewed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "fileCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "label",
        "confidence"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "enum": [
            "entry-point",
            "editable-source",
            "protected-input",
            "generated-output",
            "evidence",
            "instructions",
            "unknown"
          ]
        },
        "label": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "unresolvedItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "question"
      ],
      "properties": {
        "field": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "question": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ai-draft",
            "owner-reviewed",
            "verified"
          ]
        },
        "reviewed_by": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "owner-reviewed",
                  "verified"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewed_by",
              "reviewed_at"
            ]
          }
        }
      ]
    },
    "artifactFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "file_count",
        "total_size_bytes",
        "inventory_digest",
        "generated_at",
        "source_name"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-inventory-v1"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "intake": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "created_at",
        "mode",
        "detected_type",
        "sources",
        "observations",
        "owner_questions"
      ],
      "properties": {
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "mode": {
          "enum": [
            "json",
            "folder",
            "zip",
            "passport-migration",
            "passport-repair"
          ]
        },
        "detected_type": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/intakeSource"
          }
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/intakeObservation"
          }
        },
        "inventory": {
          "$ref": "#/$defs/stringList"
        },
        "file_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fileCandidate"
          }
        },
        "owner_questions": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "kind",
        "description",
        "updated_at"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "kind": {
          "type": "string",
          "enum": [
            "application",
            "document",
            "dataset",
            "media",
            "model",
            "package",
            "source-code",
            "website",
            "workflow",
            "other"
          ]
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string"
        },
        "tags": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "audiences",
        "success_criteria"
      ],
      "properties": {
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "audiences": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "success_criteria": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "out_of_scope": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "entryPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "open_with"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "open_with": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "requirement",
        "purpose"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "requirement": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "purpose": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "type": "string"
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entry_points",
        "environment",
        "network_policy",
        "dependencies"
      ],
      "properties": {
        "entry_points": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/entryPoint"
          }
        },
        "environment": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "network_policy": {
          "enum": [
            "forbidden",
            "optional",
            "required"
          ]
        },
        "network_notes": {
          "type": "string"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        }
      }
    },
    "structure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_of_truth",
        "generated_outputs",
        "protected_items",
        "ignore"
      ],
      "properties": {
        "source_of_truth": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/pathItem"
          }
        },
        "generated_outputs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathItem"
          }
        },
        "protected_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pathItem"
          }
        },
        "ignore": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_actions",
        "must",
        "must_not",
        "preserve",
        "data_handling"
      ],
      "properties": {
        "allowed_actions": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "must": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "must_not": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "preserve": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "data_classification": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "mixed",
            "unspecified"
          ]
        },
        "data_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "may_leave_device",
            "approved_contexts",
            "redaction_required"
          ],
          "properties": {
            "may_leave_device": {
              "enum": [
                "yes",
                "no",
                "ask-owner"
              ]
            },
            "approved_contexts": {
              "$ref": "#/$defs/stringList"
            },
            "redaction_required": {
              "type": "boolean"
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "procedures": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "setup",
        "edit",
        "build",
        "verify",
        "release",
        "recovery"
      ],
      "properties": {
        "setup": {
          "$ref": "#/$defs/stringList"
        },
        "edit": {
          "$ref": "#/$defs/stringList"
        },
        "build": {
          "$ref": "#/$defs/stringList"
        },
        "verify": {
          "$ref": "#/$defs/stringList"
        },
        "release": {
          "$ref": "#/$defs/stringList"
        },
        "recovery": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "expected",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "description": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "method": {
          "enum": [
            "command",
            "inspection",
            "interaction",
            "comparison",
            "other"
          ]
        },
        "command": {
          "type": "string"
        },
        "expected": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checks"
      ],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "contains": {
            "type": "object",
            "required": [
              "required"
            ],
            "properties": {
              "required": {
                "const": true
              }
            }
          },
          "items": {
            "$ref": "#/$defs/check"
          }
        },
        "last_verified": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "at",
            "by",
            "result"
          ],
          "properties": {
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "by": {
              "$ref": "#/$defs/nonEmptyString"
            },
            "result": {
              "enum": [
                "passed",
                "failed",
                "partial"
              ]
            },
            "notes": {
              "type": "string"
            }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "role"
      ],
      "properties": {
        "title": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "location": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "contributors": {
          "$ref": "#/$defs/stringList"
        },
        "generated_with": {
          "$ref": "#/$defs/stringList"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owner",
        "approvers",
        "change_policy"
      ],
      "properties": {
        "owner": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "approvers": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "change_policy": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "contact": {
          "type": "string"
        }
      }
    },
    "handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_here",
        "safe_first_actions",
        "known_limitations",
        "open_questions"
      ],
      "properties": {
        "start_here": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "safe_first_actions": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "known_limitations": {
          "$ref": "#/$defs/stringList"
        },
        "open_questions": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
