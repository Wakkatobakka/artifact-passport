{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artifact-passport:handoff-schema:0.7",
  "title": "Artifact Handoff 0.7",
  "description": "A current-state companion to a stable Artifact Passport, including an explicit context snapshot for efficient continuation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "passport_id",
    "artifact",
    "updated_at",
    "review",
    "working_state",
    "context_snapshot",
    "context_routes",
    "open_questions"
  ],
  "properties": {
    "$schema": {
      "const": "urn:artifact-passport:handoff-schema:0.7"
    },
    "spec_version": {
      "const": "0.7"
    },
    "passport_id": {
      "type": "string",
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "working_state": {
      "$ref": "#/$defs/workingState"
    },
    "context_routes": {
      "$ref": "#/$defs/contextRoutes"
    },
    "artifact_fingerprint": {
      "$ref": "#/$defs/artifactFingerprint"
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidenceItem"
      }
    },
    "open_questions": {
      "$ref": "#/$defs/stringList"
    },
    "notes": {
      "type": "string"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[A-Za-z0-9]+(?:[.-][A-Za-z0-9]+)+$"
      },
      "additionalProperties": true
    },
    "context_snapshot": {
      "$ref": "#/$defs/contextSnapshot"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "stringList": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ai-draft",
            "owner-reviewed",
            "verified"
          ]
        },
        "reviewed_by": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "owner-reviewed",
                  "verified"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "reviewed_by",
              "reviewed_at"
            ]
          }
        }
      ]
    },
    "failedAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "outcome"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "outcome": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "avoid_repeating": {
          "type": "boolean"
        }
      }
    },
    "workingState": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_status",
        "current_known_good",
        "current_objective",
        "recommended_next_move",
        "failed_attempts"
      ],
      "properties": {
        "current_status": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "current_known_good": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "last_material_change": {
          "type": "string"
        },
        "current_objective": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "recommended_next_move": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "failed_attempts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/failedAttempt"
          }
        }
      }
    },
    "taskRoute": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task",
        "read"
      ],
      "properties": {
        "task": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "read": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "contextRoutes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "always_read",
        "by_task",
        "avoid_by_default"
      ],
      "properties": {
        "always_read": {
          "$ref": "#/$defs/stringList",
          "minItems": 1
        },
        "by_task": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/taskRoute"
          }
        },
        "avoid_by_default": {
          "$ref": "#/$defs/stringList"
        }
      }
    },
    "artifactFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "file_count",
        "total_size_bytes",
        "inventory_digest",
        "generated_at",
        "source_name"
      ],
      "properties": {
        "algorithm": {
          "const": "sha256-inventory-v1"
        },
        "file_count": {
          "type": "integer",
          "minimum": 0
        },
        "total_size_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "inventory_digest": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_name": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "evidenceItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim",
        "source",
        "result"
      ],
      "properties": {
        "claim": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "source": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "result": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "contextSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "do_not_break",
        "decision_history",
        "known_uncertainties",
        "recent_delta_from",
        "recent_delta"
      ],
      "properties": {
        "do_not_break": {
          "$ref": "#/$defs/stringList"
        },
        "decision_history": {
          "$ref": "#/$defs/stringList"
        },
        "known_uncertainties": {
          "$ref": "#/$defs/stringList"
        },
        "recent_delta_from": {
          "type": "string"
        },
        "recent_delta": {
          "$ref": "#/$defs/stringList"
        }
      }
    }
  }
}
