{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:artifact-passport:run-schema:0.7",
  "title": "Artifact Passport Run Receipt 0.7",
  "description": "An optional, non-authoritative measurement receipt for a controlled Artifact Passport handoff evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec_version",
    "passport_id",
    "artifact",
    "condition",
    "prompt_id",
    "evaluator",
    "timing",
    "work",
    "result",
    "host_usage"
  ],
  "properties": {
    "$schema": {
      "const": "urn:artifact-passport:run-schema:0.7"
    },
    "spec_version": {
      "const": "0.7"
    },
    "passport_id": {
      "type": "string",
      "minLength": 8,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]+$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "$ref": "#/$defs/nonEmptyString"
        }
      }
    },
    "condition": {
      "enum": [
        "control",
        "passport"
      ]
    },
    "prompt_id": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "artifact_inventory_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-fA-F0-9]{64}$"
    },
    "evaluator": {
      "$ref": "#/$defs/evaluator"
    },
    "timing": {
      "$ref": "#/$defs/timing"
    },
    "work": {
      "$ref": "#/$defs/work"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "host_usage": {
      "$ref": "#/$defs/hostUsage"
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "nullableCount": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "model"
      ],
      "properties": {
        "host": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "model": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "reasoning_mode": {
          "type": "string"
        },
        "tool_surface": {
          "type": "string"
        }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "started_at",
        "completed_at",
        "source",
        "time_to_usable_model_ms",
        "time_to_first_verified_claim_ms",
        "total_runtime_ms"
      ],
      "properties": {
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "completed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source": {
          "enum": [
            "host-reported",
            "manual",
            "estimated",
            "unavailable"
          ]
        },
        "time_to_usable_model_ms": {
          "$ref": "#/$defs/nullableCount"
        },
        "time_to_first_verified_claim_ms": {
          "$ref": "#/$defs/nullableCount"
        },
        "total_runtime_ms": {
          "$ref": "#/$defs/nullableCount"
        }
      }
    },
    "work": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientation_actions",
        "verification_actions",
        "other_actions",
        "total_tool_actions",
        "unique_files_read",
        "unnecessary_file_reads"
      ],
      "properties": {
        "orientation_actions": {
          "type": "integer",
          "minimum": 0
        },
        "verification_actions": {
          "type": "integer",
          "minimum": 0
        },
        "other_actions": {
          "type": "integer",
          "minimum": 0
        },
        "total_tool_actions": {
          "type": "integer",
          "minimum": 0
        },
        "unique_files_read": {
          "type": "integer",
          "minimum": 0
        },
        "unnecessary_file_reads": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "usable_project_model",
        "claims_verified",
        "contradictions_found",
        "incorrect_assumptions",
        "clarification_loops",
        "backtracking_events",
        "unsafe_actions_proposed"
      ],
      "properties": {
        "usable_project_model": {
          "type": "boolean"
        },
        "claims_verified": {
          "type": "integer",
          "minimum": 0
        },
        "contradictions_found": {
          "type": "integer",
          "minimum": 0
        },
        "incorrect_assumptions": {
          "type": "integer",
          "minimum": 0
        },
        "clarification_loops": {
          "type": "integer",
          "minimum": 0
        },
        "backtracking_events": {
          "type": "integer",
          "minimum": 0
        },
        "unsafe_actions_proposed": {
          "type": "integer",
          "minimum": 0
        },
        "rubric_score": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "rubric_max": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "hostUsage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "reported",
            "unavailable",
            "not-recorded"
          ]
        },
        "input_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "cached_input_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "output_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "reasoning_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "total_tokens": {
          "$ref": "#/$defs/nullableCount"
        },
        "credits": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "source": {
          "type": "string"
        }
      }
    }
  }
}
